# ── ContextBridge AI Configuration ────────────────────────────────
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=ContextBridge AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DB_NAME=contextbridge

# Ollama / LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma:7b
GEMMA_SUMMARIZE_MODEL=gemma:7b
GEMMA_QUERY_MODEL=gemma:7b
OLLAMA_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_SIZE_KB=100

# RAG (Optional)
RAG_ENABLED=false
RAG_API_URL=http://localhost:8100/retrieve
RAG_CIRCUIT_BREAKER_THRESHOLD=3
RAG_CIRCUIT_BREAKER_COOLDOWN=60

# Processing
CHUNK_SIZE_CHARS=4000
CONFIDENCE_THRESHOLD=0.6
DEFAULT_PAGE_SIZE=20
